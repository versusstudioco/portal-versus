{
  "rules": {
    ".read": false,
    ".write": false,
    "vsportal": {
      ".read": "auth != null",
      ".write": false,
      "db": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren()"
      },
      "creds": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren()"
      },
      "gestor": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "onboarding": {
        ".read": "auth != null",
        "$id": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren()"
        }
      }
    }
  }
}
